module async_fifo_top #(parameter DATA_WIDTH = 8, ADDR_SIZE = 3)(
    input wr_clk, rd_clk, rst,
    input wr_en, rd_en,
    input [DATA_WIDTH-1:0] wdata,

    output [DATA_WIDTH-1:0] rdata,
    output full, empty
);

wire [ADDR_SIZE:0] wptr_bin, wptr_gray;
wire [ADDR_SIZE:0] rptr_bin, rptr_gray;

wire [ADDR_SIZE:0] wptr_gray_sync, rptr_gray_sync;

// Write pointer
write_ptr_gray #(ADDR_SIZE) wptr (
    wr_clk, rst, wr_en, full,
    wptr_bin, wptr_gray
);

// Read pointer
read_ptr_gray #(ADDR_SIZE) rptr (
    rd_clk, rst, rd_en, empty,
    rptr_bin, rptr_gray
);

// Synchronizers
sync_ptr #(ADDR_SIZE) sync_w2r (
    rd_clk, rst, wptr_gray, wptr_gray_sync
);

sync_ptr #(ADDR_SIZE) sync_r2w (
    wr_clk, rst, rptr_gray, rptr_gray_sync
);

// Memory
fifo_mem #(DATA_WIDTH, ADDR_SIZE) mem (
    wr_clk, wr_en, wptr_bin[ADDR_SIZE-1:0], wdata,
    rd_clk, rptr_bin[ADDR_SIZE-1:0], rdata
);

// Flags
empty_flag #(ADDR_SIZE) emp (
    rptr_gray, wptr_gray_sync, empty
);

full_flag #(ADDR_SIZE) ful (
    wptr_gray, rptr_gray_sync, full
);

endmodule
