module read_ptr_gray #(parameter SIZE = 3)(
    input rd_clk,
    input rst,
    input rd_en,
    input empty,

    output reg [SIZE:0] rptr_bin,
    output reg [SIZE:0] rptr_gray
);

always @(posedge rd_clk or posedge rst)
begin
    if (rst)
        rptr_bin <= 0;
    else if (rd_en && !empty)
        rptr_bin <= rptr_bin + 1;
end

always @(posedge rd_clk or posedge rst)
begin
    if (rst)
        rptr_gray <= 0;
    else
        rptr_gray <= (rptr_bin >> 1) ^ rptr_bin;
end

endmodule
