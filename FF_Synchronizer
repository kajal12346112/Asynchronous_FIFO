module sync_ptr #(parameter SIZE = 3)(
    input clk,
    input rst,
    input [SIZE:0] ptr_in,
    output reg [SIZE:0] ptr_out
);

reg [SIZE:0] temp;

always @(posedge clk or posedge rst)
begin
    if (rst)
    begin
        temp <= 0;
        ptr_out <= 0;
    end
    else
    begin
        temp <= ptr_in;
        ptr_out <= temp;
    end
end

endmodule
